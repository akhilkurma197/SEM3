{
  "manifest_version": 3,
  "name": "Trust Layer - AI Fraud Prevention",
  "version": "1.0.0",
  "description": "Pre-action AI verification against phishing links, quishing QR codes, and fake payment receipts.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Trust Layer Security Center"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
